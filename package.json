{
  "name": "local-inspect",
  "version": "1.0.3",
  "description": "Local Webview Inspector",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.example.localinspect",
    "productName": "LocalInspect",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/server/**/*",
      "dist/**/*",
      "devtools/**/*"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost/updates/"
      }
    ]
  },
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^5.3.0",
    "express": "^4.19.2",
    "http-proxy": "^1.18.1",
    "rrweb": "^2.0.1",
    "rrweb-player": "^2.0.1",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "autoprefixer": "^10.4.14",
    "electron": "^22.3.27",
    "electron-builder": "^23.6.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "vite": "^4.5.14"
  }
}
