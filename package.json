{
  "name": "ztools",
  "version": "2.0.4",
  "description": "Local Webview Inspector",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "release": "node release.js"
  },
  "build": {
    "appId": "com.example.ztools",
    "productName": "ztools",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/server/**/*",
      "dist/**/*",
      "devtools/**/*",
      "build/icon.png"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zhaichong",
        "repo": "zdevtools"
      }
    ]
  },
  "author": "Antigravity",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaichong/zdevtools.git"
  },
  "dependencies": {
    "electron-updater": "^5.3.0",
    "express": "^4.19.2",
    "http-proxy": "^1.18.1",
    "prompts": "^2.4.2",
    "rrweb": "^2.0.1",
    "rrweb-player": "^2.0.1",
    "vue": "^3.5.38",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "autoprefixer": "^10.4.14",
    "electron": "^22.3.27",
    "electron-builder": "^23.6.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "vite": "^4.5.14"
  }
}
