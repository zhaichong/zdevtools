{
  "name": "ztools",
  "version": "1.0.14",
  "description": "Local Webview Inspector",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node tests/diagnostic-run.test.mjs",
    "start": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "release": "node release.js"
  },
  "build": {
    "appId": "com.example.ztools",
    "productName": "ztools",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/server/**/*",
      "dist/**/*",
      "devtools/**/*",
      "build/icon.png"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zhaichong",
        "repo": "zdevtools",
        "releaseType": "release"
      }
    ]
  },
  "author": "Antigravity",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaichong/zdevtools.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "autoprefixer": "^10.4.14",
    "electron": "^40.8.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.16",
    "prompts": "^2.4.2",
    "rrweb": "^2.0.1",
    "rrweb-player": "^2.0.1",
    "tailwindcss": "^3.3.0",
    "vite": "^4.5.14",
    "vue": "^3.5.38",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "volta": {
    "node": "20.20.2"
  }
}
